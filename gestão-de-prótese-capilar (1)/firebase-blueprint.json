{
  "entities": {
    "Client": {
      "title": "Client",
      "description": "Client record details",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "phone": { "type": "string" },
        "email": { "type": "string" },
        "cep": { "type": "string" },
        "notes": { "type": "string" },
        "hairColor": { "type": "string" },
        "baseType": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "name", "phone", "createdAt"]
    },
    "Appointment": {
      "title": "Appointment",
      "description": "Appointment schedule details",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "clientId": { "type": "string" },
        "clientName": { "type": "string" },
        "clientPhone": { "type": "string" },
        "date": { "type": "string" },
        "startTime": { "type": "string" },
        "endTime": { "type": "string" },
        "serviceName": { "type": "string" },
        "price": { "type": "number" },
        "notes": { "type": "string" },
        "status": { "type": "string" },
        "paymentStatus": { "type": "string" },
        "paymentMethod": { "type": "string" },
        "googleEventId": { "type": "string" },
        "recurrence": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "clientId", "clientName", "clientPhone", "date", "startTime", "endTime", "serviceName", "price", "status", "paymentStatus", "createdAt"]
    },
    "FinancialTransaction": {
      "title": "FinancialTransaction",
      "description": "Financial entry or exit transaction record",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "type": { "type": "string" },
        "amount": { "type": "number" },
        "date": { "type": "string" },
        "description": { "type": "string" },
        "appointmentId": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "type", "amount", "date", "description", "createdAt"]
    },
    "ClinicSettings": {
      "title": "ClinicSettings",
      "description": "General settings of the clinic",
      "type": "object",
      "properties": {
        "clinicName": { "type": "string" },
        "googleClientId": { "type": "string" },
        "calendarId": { "type": "string" },
        "enableGoogleCalendar": { "type": "boolean" },
        "theme": { "type": "string" }
      },
      "required": ["clinicName", "googleClientId", "calendarId", "enableGoogleCalendar"]
    },
    "ServiceCategory": {
      "title": "ServiceCategory",
      "description": "Service categories available",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "description": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "name", "createdAt"]
    },
    "Service": {
      "title": "Service",
      "description": "Service details under a specific category",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "categoryId": { "type": "string" },
        "price": { "type": "number" },
        "durationMinutes": { "type": "number" },
        "description": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "name", "categoryId", "price", "durationMinutes", "createdAt"]
    }
  },
  "firestore": {
    "/clients/{clientId}": {
      "schema": "Client",
      "description": "Collection of hair prosthesis clinic clients"
    },
    "/appointments/{apptId}": {
      "schema": "Appointment",
      "description": "Collection of appointments made by clients"
    },
    "/transactions/{txId}": {
      "schema": "FinancialTransaction",
      "description": "Collection of cash inflow and outflow transactions"
    },
    "/settings/{settingsId}": {
      "schema": "ClinicSettings",
      "description": "General settings configuration for the app"
    },
    "/categories/{catId}": {
      "schema": "ServiceCategory",
      "description": "Collection of service categories"
    },
    "/services/{serviceId}": {
      "schema": "Service",
      "description": "Collection of service definitions"
    }
  }
}
